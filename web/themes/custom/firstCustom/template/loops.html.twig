<h1>Loops</h1>

{% set array=[] %}

{% for item in array %}
  {{ item }}
{% else %}
  <p>No hay usuarios disponibles</p>
{% endfor %}

{% for i in 0..10 %}
  {{ i }},
{% endfor %}

{% for letter in 'a'..'z' %}
  {{ letter }},
{% endfor %}

